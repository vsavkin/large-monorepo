{
  "extends": "nx/presets/npm.json",
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build"
        ],
        "parallel": 3
      }
    }
  },
  "tui": {
    "enabled": false
  },
  "targetDefaults": {
    "build": {
      "outputs": [
        "{projectRoot}/.next"
      ]
    }
  }
}
